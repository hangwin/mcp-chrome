{
  "name": "mcp-chrome-bridge",
  "version": "1.0.29",
  "description": "Chrome Native-Messaging host (Node)",
  "main": "dist/index.js",
  "bin": {
    "mcp-chrome-bridge": "./dist/cli.js",
    "chrome-mcp-bridge": "./dist/cli.js",
    "mcp-chrome-stdio": "./dist/mcp/mcp-server-stdio.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/ --exec \"npm run build && npm run register:dev\"",
    "build": "ts-node src/scripts/build.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "register:dev": "node dist/scripts/register-dev.js",
    "postinstall": "node dist/scripts/postinstall.js"
  },
  "files": [
    "dist",
    "!dist/node_path.txt"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "mcp",
    "chrome",
    "browser"
  ],
  "author": "hangye",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.69",
    "@fastify/cors": "11.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node-fetch": "2",
    "better-sqlite3": "11.10.0",
    "chalk": "5.6.2",
    "chrome-devtools-frontend": "1.0.1556696",
    "chrome-mcp-shared": "workspace:*",
    "commander": "13.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "is-admin": "4.0.0",
    "node-fetch": "2",
    "pino": "9.14.0",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/chrome": "0.0.318",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.2",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/parser": "8.49.0",
    "cross-env": "7.0.3",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "15.5.2",
    "nodemon": "3.1.11",
    "pino-pretty": "13.1.3",
    "rimraf": "6.1.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
